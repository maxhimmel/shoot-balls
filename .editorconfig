[*.cs]

# New line before opening brace (Allman style)
csharp_new_line_before_open_brace = all

# Space inside method declaration parentheses
csharp_space_between_method_declaration_parameter_list_parentheses = true

# Space inside method call parentheses (optional but keeps things consistent)
csharp_space_between_method_call_parameter_list_parentheses = true

# Space inside control flow parentheses (THIS is what you want)
csharp_space_between_parentheses = control_flow_statements

# Space after comma
csharp_space_after_comma = true

# Optional: consistent indentation
indent_style = space
indent_size = 4